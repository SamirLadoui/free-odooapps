<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Settings to Add POS Cache Options -->
        <record id="res_config_settings_view_form_pos_cache" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.pos.cache</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="65"/>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="POS Cache Optimization" string="POS Cache Optimization" data-key="pos_cache_optimizer">
                        <h2>POS Cache Optimization</h2>
                        
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="pos_cache_global_enable"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="pos_cache_global_enable"/>
                                    <div class="text-muted">
                                        Enable POS cache optimization globally for better performance with large product catalogs
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-12 col-lg-6 o_setting_box" 
                                 attrs="{'invisible': [('pos_cache_global_enable', '=', False)]}">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="pos_cache_default_strategy"/>
                                    <field name="pos_cache_default_strategy" class="o_light_label"/>
                                    <div class="text-muted">
                                        Default cache strategy for new POS configurations
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mt16 o_settings_container" 
                             attrs="{'invisible': [('pos_cache_global_enable', '=', False)]}">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="pos_cache_default_size_limit"/>
                                    <field name="pos_cache_default_size_limit" class="o_light_label"/>
                                    <div class="text-muted">
                                        Default maximum cache size in megabytes
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="pos_cache_default_preload_count"/>
                                    <field name="pos_cache_default_preload_count" class="o_light_label"/>
                                    <div class="text-muted">
                                        Default number of products to preload
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mt16 o_settings_container" 
                             attrs="{'invisible': [('pos_cache_global_enable', '=', False)]}">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="pos_cache_compression_enable"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="pos_cache_compression_enable"/>
                                    <div class="text-muted">
                                        Enable data compression by default to reduce memory usage
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="pos_cache_image_lazy_loading"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="pos_cache_image_lazy_loading"/>
                                    <div class="text-muted">
                                        Load product images only when needed
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mt16 o_settings_container" 
                             attrs="{'invisible': [('pos_cache_global_enable', '=', False)]}">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="pos_cache_background_sync_enable"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="pos_cache_background_sync_enable"/>
                                    <div class="text-muted">
                                        Update cache in background while POS is running
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="pos_cache_analytics_retention_days"/>
                                    <field name="pos_cache_analytics_retention_days" class="o_light_label"/>
                                    <div class="text-muted">
                                        Number of days to keep analytics data
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="row mt16 o_settings_container" 
                             attrs="{'invisible': [('pos_cache_global_enable', '=', False)]}">
                            <div class="col-12">
                                <h3>Management Actions</h3>
                                <div class="row">
                                    <div class="col-lg-4">
                                        <button name="action_apply_default_cache_settings" 
                                                type="object" 
                                                string="Apply Default Settings" 
                                                class="btn btn-primary"
                                                help="Apply these default settings to all POS configurations"/>
                                    </div>
                                    <div class="col-lg-4">
                                        <button name="action_optimize_all_products_cache" 
                                                type="object" 
                                                string="Optimize All Products" 
                                                class="btn btn-secondary"
                                                help="Optimize all products for cache performance"/>
                                    </div>
                                    <div class="col-lg-4">
                                        <button name="action_view_cache_analytics" 
                                                type="object" 
                                                string="View Analytics" 
                                                class="btn btn-info"
                                                help="View cache performance analytics"/>
                                    </div>
                                </div>
                                <div class="row mt8">
                                    <div class="col-lg-4">
                                        <button name="action_cleanup_old_analytics" 
                                                type="object" 
                                                string="Cleanup Old Data" 
                                                class="btn btn-warning"
                                                help="Remove old analytics data"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Information Panel -->
                        <div class="row mt16 o_settings_container" 
                             attrs="{'invisible': [('pos_cache_global_enable', '=', False)]}">
                            <div class="col-12">
                                <div class="alert alert-info" role="alert">
                                    <h4 class="alert-heading">Cache Optimization Benefits:</h4>
                                    <ul class="mb-0">
                                        <li><strong>Faster Loading:</strong> Reduce initial POS loading time by 60-80%</li>
                                        <li><strong>Better Performance:</strong> Improve product search and navigation</li>
                                        <li><strong>Memory Efficient:</strong> Smart caching strategies minimize memory usage</li>
                                        <li><strong>Offline Capability:</strong> Cache enables limited offline functionality</li>
                                        <li><strong>Analytics:</strong> Monitor and optimize cache performance</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
