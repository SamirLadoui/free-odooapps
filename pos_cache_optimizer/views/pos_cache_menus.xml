<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Main Menu for POS Cache Optimizer -->
        <menuitem id="menu_pos_cache_main" 
                  name="POS Cache" 
                  parent="point_of_sale.menu_point_root" 
                  sequence="50"/>

        <!-- Configuration Menu -->
        <menuitem id="menu_pos_cache_configuration" 
                  name="Configuration" 
                  parent="menu_pos_cache_main" 
                  sequence="10"/>

        <!-- Cache Configurations -->
        <menuitem id="menu_pos_cache_config" 
                  name="Cache Configurations" 
                  parent="menu_pos_cache_configuration" 
