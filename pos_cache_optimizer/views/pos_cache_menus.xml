        <menuitem id="menu_pos_cache_dashboard" 
                  name="Performance Dashboard" 
                  parent="menu_pos_cache_analytics_main" 
                  action="action_pos_cache_analytics_dashboard" 
                  sequence="20"/>

        <!-- Add shortcut to POS configurations with cache info -->
        <menuitem id="menu_pos_config_cache" 
                  name="POS Configurations" 
                  parent="menu_pos_cache_configuration" 
