<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_pack" model="ir.ui.view">
        <field name="name">product.template.form.pack</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="sl_pack_ok"/>
                <field name="sl_pack_type"
                       invisible="sl_pack_ok == False"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Pack Contents" name="sl_pack"
                      invisible="sl_pack_ok == False">
                    <field name="sl_pack_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"
                                   options="{'no_create': True}"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                    <div class="text-muted">
                        Selling this pack puts these parts on the order. The
                        pack itself is not counted in stock, so the parts are
                        what leaves the warehouse.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_pack" model="ir.ui.view">
        <field name="name">sale.order.form.pack</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
                   position="before">
                <field name="sl_pack_parent_id" column_invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
