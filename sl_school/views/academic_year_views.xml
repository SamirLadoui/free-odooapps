<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_academic_year_list" model="ir.ui.view">
        <field name="name">sl.academic.year.list</field>
        <field name="model">sl.academic.year</field>
        <field name="arch" type="xml">
            <list string="Academic Years" decoration-success="state == 'open'"
                  decoration-muted="state == 'closed'">
                <field name="code"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="standard_count" string="Classes"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_academic_year_form" model="ir.ui.view">
        <field name="name">sl.academic.year.form</field>
        <field name="model">sl.academic.year</field>
        <field name="arch" type="xml">
            <form string="Academic Year">
                <header>
                    <button name="action_open" type="object" string="Open Year"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close Year"
                            invisible="state != 'open'"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_standards" type="object"
                                class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="standard_count" widget="statinfo" string="Classes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/><!-- drives the Archived ribbon and the archive action -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="2025 / 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="2025-26"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Classes" name="standards">
                            <field name="standard_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="division"/>
                                    <field name="class_teacher_id"/>
                                    <field name="student_count"/>
                                    <field name="capacity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">sl.academic.year</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first academic year</p>
            <p>Everything else - classes, enrolments, registers - hangs off an academic year.</p>
        </field>
    </record>

</odoo>
