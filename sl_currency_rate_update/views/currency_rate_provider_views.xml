<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_currency_rate_provider_list" model="ir.ui.view">
        <field name="name">sl.currency.rate.provider.list</field>
        <field name="model">sl.currency.rate.provider</field>
        <field name="arch" type="xml">
            <tree string="Rate Providers" decoration-danger="last_state == 'fail'">
                <field name="provider"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="company_currency_id"/>
                <field name="currency_ids" widget="many2many_tags"/>
                <field name="last_run"/>
                <field name="last_state" widget="badge"
                       decoration-success="last_state == 'ok'"
                       decoration-danger="last_state == 'fail'"/>
                <button name="action_update_rates" type="object" string="Update Now"
                        icon="fa-refresh" class="btn-link"/>
            </tree>
        </field>
    </record>

    <record id="view_currency_rate_provider_form" model="ir.ui.view">
        <field name="name">sl.currency.rate.provider.form</field>
        <field name="model">sl.currency.rate.provider</field>
        <field name="arch" type="xml">
            <form string="Rate Provider">
                <header>
                    <button name="action_update_rates" type="object"
                            string="Update Now" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" attrs="{'invisible': [('active', '!=', False)]}"/>
                    <field name="active" invisible="1"/><!-- drives the Archived ribbon and the archive action -->
                    <field name="name" invisible="1"/><!-- computed label used in cron logs and failure messages -->
                    <group>
                        <group>
                            <field name="provider"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                            <field name="company_currency_id"/>
                        </group>
                        <group>
                            <field name="last_run"/>
                            <field name="last_state"/>
                        </group>
                    </group>
                    <group string="Currencies To Update">
                        <field name="currency_ids" widget="many2many_tags" nolabel="1"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Last Result" attrs="{'invisible': [('last_message', '=', False)]}">
                        <field name="last_message" nolabel="1"/>
                    </group>
                    <div class="alert alert-info" role="status">
                        Both providers publish European Central Bank reference rates and
                        need no account or API key. Rates are re-expressed against the
                        company currency before they are stored, so a company on a
                        currency other than EUR gets correct figures.
                        Enable the <b>Update Currency Rates</b> scheduled action to run
                        this daily; it ships disabled.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_currency_rate_provider" model="ir.actions.act_window">
        <field name="name">Currency Rate Providers</field>
        <field name="res_model">sl.currency.rate.provider</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up automatic rate updates</p>
            <p>
                Pick a provider and the currencies you deal in. Rates are fetched
                daily and written against your company currency.
            </p>
        </field>
    </record>

    <!-- base.menu_administration is the one parent present on every version;
         the currency menus live under Accounting, which this module does not
         depend on. -->
    <menuitem id="menu_currency_rates_root" name="Currency Rates"
              parent="base.menu_administration" sequence="62"
              groups="base.group_system"/>
    <menuitem id="menu_currency_rate_provider" name="Rate Providers"
              parent="menu_currency_rates_root" action="action_currency_rate_provider"
              sequence="10"/>

</odoo>
