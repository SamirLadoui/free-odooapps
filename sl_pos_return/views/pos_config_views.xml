<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_sl_pos_return" model="ir.ui.view">
        <field name="name">res.config.settings.form.sl.pos.return</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pos_interface_section']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="sl_pos_return_setting">
                    <div class="o_setting_left_pane">
                        <field name="pos_sl_allow_returns"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pos_sl_allow_returns"/>
                        <div class="text-muted">
                            Let a cashier give items back against a past receipt.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_form_sl_return" model="ir.ui.view">
        <field name="name">pos.order.form.sl.return</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sl_return_of_order_id" readonly="1"
                       attrs="{'invisible': [('sl_return_of_order_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>
