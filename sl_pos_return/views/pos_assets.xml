<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 14.0 has no assets dict in the manifest for the point of sale: the
         bundle is an inherited template. -->
    <template id="assets" inherit_id="point_of_sale.assets">
        <xpath expr="." position="inside">
            <script type="text/javascript"
                    src="/sl_pos_return/static/src/js/pos_return.js"></script>
        </xpath>
    </template>

</odoo>
