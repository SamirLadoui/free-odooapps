<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sl_contract" model="ir.sequence">
            <field name="name">Contract Reference</field>
            <field name="code">sl.contract</field>
            <field name="prefix">CON/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <record id="ir_cron_recurring_invoices" model="ir.cron">
        <field name="name">Contracts: Generate Recurring Invoices</field>
        <field name="model_id" ref="model_sl_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_recurring_invoices()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="numbercall">-1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
