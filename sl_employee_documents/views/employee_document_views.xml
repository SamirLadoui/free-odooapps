<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_document_type_list" model="ir.ui.view">
        <field name="name">sl.employee.document.type.list</field>
        <field name="model">sl.employee.document.type</field>
        <field name="arch" type="xml">
            <tree string="Document Types" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="expires"/>
                <field name="reminder_days"/>
            </tree>
        </field>
    </record>

    <record id="action_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">sl.employee.document.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_document_list" model="ir.ui.view">
        <field name="name">sl.employee.document.list</field>
        <field name="model">sl.employee.document</field>
        <field name="arch" type="xml">
            <tree string="Employee Documents"
                  decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring'">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="type_id"/>
                <field name="number" optional="show"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry" string="Days Left"/>
                <field name="responsible_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"/>
            </tree>
        </field>
    </record>

    <record id="view_document_form" model="ir.ui.view">
        <field name="name">sl.employee.document.form</field>
        <field name="model">sl.employee.document</field>
        <field name="arch" type="xml">
            <form string="Employee Document">
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="state != 'expired'"/>
                    <field name="active" invisible="1"/><!-- drives the archive action -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Passport"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="type_id"/>
                            <field name="number"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="state" readonly="1"/>
                            <field name="days_to_expiry" readonly="1"
                                   invisible="state == 'no_expiry'"/>
                            <field name="last_reminder_on" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_document_search" model="ir.ui.view">
        <field name="name">sl.employee.document.search</field>
        <field name="model">sl.employee.document</field>
        <field name="arch" type="xml">
            <search string="Employee Documents">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="type_id"/>
                <field name="number"/>
                <filter name="filter_expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter name="filter_expiring" string="Expiring Soon"
                        domain="[('state', '=', 'expiring')]"/>
                <filter name="filter_valid" string="Valid"
                        domain="[('state', '=', 'valid')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'type_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_employee_document" model="ir.actions.act_window">
        <field name="name">Employee Documents</field>
        <field name="res_model">sl.employee.document</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_expiring': 1, 'search_default_filter_expired': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first document</p>
            <p>
                Passports, visas, licences and contracts, with their expiry dates.
                Enable the reminder scheduled action and nothing lapses unnoticed.
            </p>
        </field>
    </record>

    <record id="view_employee_form_documents" model="ir.ui.view">
        <field name="name">hr.employee.form.documents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_documents" type="object"
                        class="oe_stat_button" icon="fa-id-card">
                    <field name="document_count" widget="statinfo" string="Documents"/>
                </button>
            </div>
        </field>
    </record>

    <menuitem id="menu_employee_documents" name="Documents"
              parent="hr.menu_hr_root" action="action_employee_document"
              sequence="45" groups="hr.group_hr_user"/>
    <menuitem id="menu_employee_document_types" name="Document Types"
              parent="hr.hr_menu_configuration" action="action_document_type"
              sequence="45" groups="hr.group_hr_manager"/>

</odoo>
