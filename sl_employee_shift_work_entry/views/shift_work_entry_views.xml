<odoo>
    <record id="view_contract_shift_source_form" model="ir.ui.view">
        <field name="name">hr.contract.shift.source.form</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='top_info_right']" position="inside">
                <field name="sl_shift_work_entry_source"/>
            </xpath>
        </field>
    </record>
    <record id="view_assignment_work_entry_form" model="ir.ui.view">
        <field name="name">sl.shift.assignment.work.entry.form</field>
        <field name="model">sl.shift.assignment</field>
        <field name="inherit_id" ref="sl_employee_shift_attendance.view_assignment_attendance_form"/>
        <field name="arch" type="xml">
            <group name="attendance_integration" position="after">
                <group string="Explicit Manual Work Entry Mapping">
                    <field name="work_entry_enabled"/>
                    <field name="regular_type_id" attrs="{'invisible': [('work_entry_enabled', '=', False)], 'required': [('work_entry_enabled', '=', True)]}"/>
                    <field name="overtime_type_id" attrs="{'invisible': [('work_entry_enabled', '=', False)], 'required': [('work_entry_enabled', '=', True)]}"/>
                    <div class="alert alert-info" role="status" attrs="{'invisible': [('work_entry_enabled', '=', False)]}">
                        Select Shift Summary (Explicit Manual Generation) as the historical
                        contract work-entry source too. Automatic native generation
                        does not run for that source. Hours are split on actual local dates;
                        presence remains on the shift-start date. No salary rule is changed.
                    </div>
                </group>
            </group>
        </field>
    </record>
    <record id="view_shift_day_work_entry_form" model="ir.ui.view">
        <field name="name">sl.shift.day.work.entry.form</field>
        <field name="model">sl.shift.day</field>
        <field name="inherit_id" ref="sl_employee_shift_attendance.view_shift_day_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_generate_and_open_work_entries" type="object" string="Generate / Open Work Entries"
                        groups="hr.group_hr_manager" attrs="{'invisible': [('state', 'in', ['open', 'void'])]}"/>
            </header>
            <notebook position="inside">
                <page string="Native Work Entries">
                    <field name="work_entry_ids" readonly="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="date_start"/><field name="date_stop"/>
                            <field name="sl_shift_kind"/>
                            <field name="work_entry_type_id"/>
                            <field name="duration" widget="float_time"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
