<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_attendance_list" model="ir.ui.view">
        <field name="name">sl.school.attendance.list</field>
        <field name="model">sl.school.attendance</field>
        <field name="arch" type="xml">
            <tree string="Attendance Registers" decoration-success="state == 'confirmed'">
                <field name="date"/>
                <field name="standard_id"/>
                <field name="taken_by_id" optional="show"/>
                <field name="present_count" string="Present"/>
                <field name="absent_count" string="Absent"/>
                <field name="attendance_rate" widget="percentage" string="Rate"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"/>
            </tree>
        </field>
    </record>

    <record id="view_attendance_form" model="ir.ui.view">
        <field name="name">sl.school.attendance.form</field>
        <field name="model">sl.school.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance Register">
                <header>
                    <button name="action_load_students" type="object"
                            string="Load Students" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_mark_all_present" type="object"
                            string="Mark All Present" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="standard_id" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="date" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="taken_by_id"/>
                            <field name="academic_year_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="present_count" readonly="1"/>
                            <field name="absent_count" readonly="1"/>
                            <field name="total_count" readonly="1"/>
                            <field name="attendance_rate" widget="percentage" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Register" name="register">
                            <field name="line_ids" attrs="{'readonly': [('state', '=', 'confirmed')]}">
                                <tree editable="bottom">
                                    <field name="student_id"/>
                                    <field name="status" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_attendance_search" model="ir.ui.view">
        <field name="name">sl.school.attendance.search</field>
        <field name="model">sl.school.attendance</field>
        <field name="arch" type="xml">
            <search string="Attendance">
                <field name="standard_id"/>
                <field name="taken_by_id"/>
                <field name="date"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_today" string="Today"
                        domain="[('date', '=', 'today')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_standard" string="Class"
                            context="{'group_by': 'standard_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">sl.school.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Take your first register</p>
            <p>
                Pick a class and a date, press Load Students, and mark the
                exceptions. Everyone starts present because in a normal class
                most people are.
            </p>
        </field>
    </record>

    <record id="view_attendance_line_list" model="ir.ui.view">
        <field name="name">sl.school.attendance.line.list</field>
        <field name="model">sl.school.attendance.line</field>
        <field name="arch" type="xml">
            <tree string="Attendance Lines" create="false">
                <field name="date"/>
                <field name="standard_id"/>
                <field name="student_id"/>
                <field name="status" widget="badge"
                       decoration-success="status in ['present', 'late']"
                       decoration-danger="status == 'absent'"/>
                <field name="note" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="action_attendance_line" model="ir.actions.act_window">
        <field name="name">Attendance Lines</field>
        <field name="res_model">sl.school.attendance.line</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="view_student_form_attendance" model="ir.ui.view">
        <field name="name">sl.student.form.attendance</field>
        <field name="model">sl.student</field>
        <field name="inherit_id" ref="sl_school.view_student_form"/>
        <field name="arch" type="xml">
            <page name="electives" position="after">
                <page string="Attendance" name="attendance">
                    <group>
                        <field name="attendance_rate" widget="percentage" readonly="1"/>
                    </group>
                    <field name="attendance_line_ids" readonly="1">
                        <tree>
                            <field name="date"/>
                            <field name="status" widget="badge"
                                   decoration-success="status in ['present', 'late']"
                                   decoration-danger="status == 'absent'"/>
                            <field name="note"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <menuitem id="menu_attendance" name="Attendance"
              parent="sl_school.menu_school_root" action="action_attendance"
              sequence="15"/>
    <menuitem id="menu_attendance_lines" name="Attendance Lines"
              parent="sl_school.menu_school_organisation" action="action_attendance_line"
              sequence="40"/>

</odoo>
