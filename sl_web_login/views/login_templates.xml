<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="login_layout_branding" inherit_id="web.login_layout" name="Login Screen Branding">

        <!-- Anchored on `card-body`, the one node in web.login_layout carrying a
             plain `class` attribute in every version from 14.0 to 19.0. The card
             itself uses t-attf-class, which hasclass() cannot see, and `alt` is a
             translated attribute so Odoo refuses it as a selector.
             `request` is likewise the one context variable present on the login
             page across all those versions, so the branding is read through it. -->
        <xpath expr="//div[hasclass('card-body')]" position="before">
            <t t-set="sl_login" t-value="request.env['res.company']._sl_login_branding()"/>
            <t t-if="sl_login['hide_db_manager']" t-set="disable_database_manager" t-value="True"/>
            <t t-if="sl_login['hide_footer']" t-set="disable_footer" t-value="True"/>
            <link rel="stylesheet" type="text/css" href="/sl_web_login/style.css"/>
        </xpath>

        <xpath expr="//div[hasclass('card-body')]/div/img" position="replace">
            <img t-if="sl_login['logo_url']" t-att-src="sl_login['logo_url']" alt="Logo"
                 t-attf-style="max-height:#{sl_login['logo_height']}px; max-width: 100%; width:auto"/>
            <img t-else="" t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                 alt="Logo" style="max-height:120px; max-width: 100%; width:auto"/>
        </xpath>

        <xpath expr="//div[hasclass('card-body')]" position="inside">
            <div t-if="sl_login['footer_text']" class="text-center small text-muted mt-3 sl_login_footer">
                <t t-out="sl_login['footer_text']"/>
            </div>
        </xpath>

    </template>

</odoo>
