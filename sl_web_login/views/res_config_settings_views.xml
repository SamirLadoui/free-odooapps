<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sl.web.login</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="after">
                <block title="Login Screen" name="sl_web_login_container">
                    <setting id="sl_login_background_setting" string="Background"
                             help="Shown full-bleed behind the login card.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="login_background_color" class="col-lg-4 o_light_label"/>
                                <field name="login_background_color" placeholder="#f1f3f5"/>
                            </div>
                            <div class="row mt16">
                                <label for="login_background_blur" class="col-lg-4 o_light_label"/>
                                <field name="login_background_blur"/>
                            </div>
                            <div class="mt16">
                                <field name="login_background" widget="image"
                                       options="{'size': [180, 100]}"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="sl_login_logo_setting" string="Logo"
                             help="Replaces the company logo on the login screen only.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="login_logo_height" class="col-lg-4 o_light_label"/>
                                <field name="login_logo_height"/>
                            </div>
                            <div class="mt16">
                                <field name="login_logo" widget="image"
                                       options="{'size': [180, 100]}"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="sl_login_card_setting" string="Card and Buttons"
                             help="Size of the login card and the colour of its main button.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="login_card_width" class="col-lg-4 o_light_label"/>
                                <field name="login_card_width"/>
                            </div>
                            <div class="row mt16">
                                <label for="login_button_color" class="col-lg-4 o_light_label"/>
                                <field name="login_button_color" placeholder="#714B67"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="sl_login_footer_setting" string="Footer"
                             help="What appears under the login form.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="login_footer_text" class="col-lg-4 o_light_label"/>
                                <field name="login_footer_text"
                                       placeholder="Need help? support@example.com"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="sl_login_hide_db_setting" string="Hide &quot;Manage Databases&quot;"
                             help="Removes the link from the login footer. This hides the link, it does not block the route.">
                        <field name="login_hide_db_manager"/>
                    </setting>
                    <setting id="sl_login_hide_footer_setting" string="Hide the whole footer"
                             help="Removes the login footer entirely, including the Odoo credit.">
                        <field name="login_hide_powered_by"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
