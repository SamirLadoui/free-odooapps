<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A sequence is provided but not attached to anything: numbering starts
         when somebody points a category or the company at it. -->
    <record id="seq_sl_product_reference" model="ir.sequence">
        <field name="name">Product References</field>
        <field name="code">sl.product.reference</field>
        <field name="prefix">P</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
