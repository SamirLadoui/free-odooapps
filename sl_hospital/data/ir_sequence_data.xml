<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hospital_patient" model="ir.sequence">
            <field name="name">Patient Number</field>
            <field name="code">sl.hospital.patient</field>
            <field name="prefix">PAT/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_hospital_doctor" model="ir.sequence">
            <field name="name">Doctor Number</field>
            <field name="code">sl.hospital.doctor</field>
            <field name="prefix">DOC/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_hospital_appointment" model="ir.sequence">
            <field name="name">Appointment Reference</field>
            <field name="code">sl.hospital.appointment</field>
            <field name="prefix">APP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
