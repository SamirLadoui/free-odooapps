<?xml version="1.0" encoding="utf-8"?>
<!-- 17.0 / 18.0 form: res.groups links straight to an ir.module.category and
     members are added through res.users.groups_id. 19.0 replaced both. -->
<odoo>
    <data noupdate="0">

        <record id="module_category_hospital" model="ir.module.category">
            <field name="name">Hospital</field>
            <field name="description">Manage departments, doctors, patients and appointments.</field>
            <field name="sequence">21</field>
        </record>

        <record id="group_hospital_user" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="category_id" ref="module_category_hospital"/>
            <field name="comment">Register patients and book appointments.</field>
        </record>

        <record id="group_hospital_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="category_id" ref="module_category_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hospital_user'))]"/>
            <field name="comment">Everything a receptionist can do, plus diagnoses and prescriptions.</field>
        </record>

        <record id="group_hospital_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hospital_doctor'))]"/>
            <field name="comment">Full control, including departments and doctor records.</field>
        </record>

        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('group_hospital_manager'))]"/>
        </record>

    </data>
</odoo>
