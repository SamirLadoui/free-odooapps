<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wizard_form" model="ir.ui.view">
        <field name="name">sl.login.as.wizard.form</field>
        <field name="model">sl.login.as.wizard</field>
        <field name="arch" type="xml">
            <form string="Log In As">
                <field name="may_do_it" invisible="1"/>
                <div class="alert alert-danger" role="alert" attrs="{'invisible': [('may_do_it', '!=', False)]}">
                    <field name="refusal" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <field name="target_user_id" options="{'no_create': True}"/>
                    <field name="reason"
                           placeholder="Checking the missing button on the sales form, ticket 4182."/>
                </group>
                <div class="alert alert-info" role="alert">
                    Who did it, whose account, when and why are recorded, and the
                    entry cannot be edited or deleted afterwards - including by
                    you.
                </div>
                <footer>
                    <button name="action_go" type="object" string="Log In As"
                            class="btn-primary" attrs="{'invisible': [('may_do_it', '=', False)]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_log_list" model="ir.ui.view">
        <field name="name">sl.login.as.log.list</field>
        <field name="model">sl.login.as.log</field>
        <field name="arch" type="xml">
            <tree string="Logged In As" create="false" edit="false" delete="false">
                <field name="happened_on"/>
                <field name="actor_user_id"/>
                <field name="target_user_id"/>
                <field name="reason"/>
            </tree>
        </field>
    </record>

    <record id="view_log_search" model="ir.ui.view">
        <field name="name">sl.login.as.log.search</field>
        <field name="model">sl.login.as.log</field>
        <field name="arch" type="xml">
            <search string="Logged In As">
                <field name="actor_user_id"/>
                <field name="target_user_id"/>
                <field name="reason"/>
                <group name="group_by">
                    <filter name="by_actor" string="Who Did It"
                            context="{'group_by': 'actor_user_id'}"/>
                    <filter name="by_target" string="Whose Account"
                            context="{'group_by': 'target_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_log" model="ir.actions.act_window">
        <field name="name">Logged In As</field>
        <field name="res_model">sl.login.as.log</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="view_users_form_login_as" model="ir.ui.view">
        <field name="name">res.users.form.login.as</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_sl_login_as" type="object"
                            string="Log In As This User"
                            groups="base.group_erp_manager"/>
                </header>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_login_as_log" name="Logged In As"
              parent="base.menu_administration"
              action="action_log" sequence="75"
              groups="base.group_erp_manager"/>

</odoo>
