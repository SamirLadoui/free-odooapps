<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_brand_list" model="ir.ui.view">
        <field name="name">sl.product.brand.list</field>
        <field name="model">sl.product.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="website" optional="hide"/>
                <field name="product_count" string="Products"/>
            </list>
        </field>
    </record>

    <record id="view_product_brand_kanban" model="ir.ui.view">
        <field name="name">sl.product.brand.kanban</field>
        <field name="model">sl.product.brand</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="logo"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <img t-att-src="kanban_image('sl.product.brand', 'logo', record.id.raw_value)"
                                 class="o_image_64_contain me-2" alt="Brand"/>
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="code"/></div>
                                <div><field name="product_count"/> product(s)</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_product_brand_form" model="ir.ui.view">
        <field name="name">sl.product.brand.form</field>
        <field name="model">sl.product.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/><!-- drives the Archived ribbon and the archive action -->
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Brand name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="website" widget="url"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">sl.product.brand</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first brand</p>
            <p>Group your products by brand, then filter and report on them.</p>
        </field>
    </record>

    <record id="view_product_template_form_brand" model="ir.ui.view">
        <field name="name">product.template.form.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="sl_brand_id"/>
            </field>
        </field>
    </record>

    <record id="view_product_template_search_brand" model="ir.ui.view">
        <field name="name">product.template.search.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="sl_brand_id"/>
            </field>
        </field>
    </record>

    <menuitem id="menu_product_brand" name="Brands"
              parent="sale.prod_config_main" action="action_product_brand"
              sequence="15"/>

</odoo>
