<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sl_label_wizard_form" model="ir.ui.view">
        <field name="name">sl.label.wizard.form</field>
        <field name="model">sl.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Labels">
                <group>
                    <group string="Sheet">
                        <field name="columns"/>
                        <field name="rows"/>
                        <field name="copies"/>
                    </group>
                    <group string="On Each Label">
                        <field name="show_code"/>
                        <field name="show_barcode"/>
                        <field name="show_price"/>
                    </group>
                </group>
                <group>
                    <field name="record_count" readonly="1"/>
                </group>
                <!-- Carried from the calling action; shown so the user can see
                     what will be printed, not edited. -->
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <footer>
                    <button name="action_print" type="object" string="Print"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sl_label_wizard" model="ir.actions.act_window">
        <field name="name">Print Labels</field>
        <field name="res_model">sl.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">tree,form</field>
    </record>

    <record id="action_sl_label_wizard_template" model="ir.actions.act_window">
        <field name="name">Print Labels</field>
        <field name="res_model">sl.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">tree,form</field>
    </record>

    <record id="action_sl_label_wizard_partner" model="ir.actions.act_window">
        <field name="name">Print Labels</field>
        <field name="res_model">sl.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">tree,form</field>
    </record>

</odoo>
