<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_line_numbers" model="ir.ui.view">
        <field name="name">account.move.form.line.numbers</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']"
                   position="before">
                <field name="sl_line_number" string="#"
                       readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
