<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_appraisal_category_list" model="ir.ui.view">
        <field name="name">sl.appraisal.category.list</field>
        <field name="model">sl.appraisal.category</field>
        <field name="arch" type="xml">
            <tree string="Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_appraisal_category" model="ir.actions.act_window">
        <field name="name">Appraisal Categories</field>
        <field name="res_model">sl.appraisal.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_appraisal_criteria_list" model="ir.ui.view">
        <field name="name">sl.appraisal.criteria.list</field>
        <field name="model">sl.appraisal.criteria</field>
        <field name="arch" type="xml">
            <tree string="Criteria" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="category_id"/>
                <field name="name"/>
                <field name="weight"/>
                <field name="description" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="action_appraisal_criteria" model="ir.actions.act_window">
        <field name="name">Appraisal Criteria</field>
        <field name="res_model">sl.appraisal.criteria</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define what you assess</p>
            <p>Criteria are grouped into categories and carry a weight, so the
               things that matter most count for most in the final score.</p>
        </field>
    </record>

    <record id="view_appraisal_list" model="ir.ui.view">
        <field name="name">sl.appraisal.list</field>
        <field name="model">sl.appraisal</field>
        <field name="arch" type="xml">
            <tree string="Appraisals" decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'">
                <field name="code"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="manager_id" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="score" widget="float" digits="[3,2]"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'in_progress'"/>
            </tree>
        </field>
    </record>

    <record id="view_appraisal_form" model="ir.ui.view">
        <field name="name">sl.appraisal.form</field>
        <field name="model">sl.appraisal</field>
        <field name="arch" type="xml">
            <form string="Appraisal">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_load_criteria" type="object"
                            string="Load Criteria" invisible="state != 'in_progress'"/>
                    <button name="action_done" type="object" string="Complete"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Who">
                            <field name="employee_id"/>
                            <field name="job_title" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="manager_id"/>
                        </group>
                        <group string="Period">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="date_close" readonly="1"/>
                            <field name="score" readonly="1" digits="[3,2]"/>
                            <field name="score_percent" widget="percentage"
                                   readonly="1" invisible="not score"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assessment" name="assessment">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="category_id" readonly="1"/>
                                    <field name="criteria_id"/>
                                    <field name="weight"/>
                                    <field name="rating"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Summary" name="summary">
                            <group>
                                <field name="strengths"
                                       placeholder="What went well over the period"/>
                                <field name="improvements"
                                       placeholder="What to work on next"/>
                                <field name="employee_comment"
                                       placeholder="The employee's own view"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_appraisal_search" model="ir.ui.view">
        <field name="name">sl.appraisal.search</field>
        <field name="model">sl.appraisal</field>
        <field name="arch" type="xml">
            <search string="Appraisals">
                <field name="code"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="department_id"/>
                <filter name="filter_in_progress" string="In Progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_done" string="Completed"
                        domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_appraisal" model="ir.actions.act_window">
        <field name="name">Appraisals</field>
        <field name="res_model">sl.appraisal</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start your first appraisal</p>
            <p>
                Pick an employee and a period, press Start, and the criteria you
                defined are loaded ready to rate.
            </p>
        </field>
    </record>

    <record id="view_employee_form_appraisal" model="ir.ui.view">
        <field name="name">hr.employee.form.appraisal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_appraisals" type="object"
                        class="oe_stat_button" icon="fa-star">
                    <field name="appraisal_count" widget="statinfo" string="Appraisals"/>
                </button>
            </div>
        </field>
    </record>

    <menuitem id="menu_appraisal" name="Appraisals"
              parent="hr.menu_hr_root" action="action_appraisal"
              sequence="46" groups="hr.group_hr_user"/>
    <menuitem id="menu_appraisal_config" name="Appraisal Criteria"
              parent="hr.hr_menu_configuration" action="action_appraisal_criteria"
              sequence="46" groups="hr.group_hr_manager"/>
    <menuitem id="menu_appraisal_categories" name="Appraisal Categories"
              parent="hr.hr_menu_configuration" action="action_appraisal_category"
              sequence="47" groups="hr.group_hr_manager"/>

</odoo>
